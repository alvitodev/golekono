# Backend API URL (without trailing slash) - CRITICAL FOR VERCEL DEPLOYMENT
# This is read at BUILD TIME, not runtime.
# Local development: http://localhost:8000
# Production: https://your-backend-app.vercel.app (example: https://backend-golekono.vercel.app)
#
# IMPORTANT: After setting this in Vercel Project Settings > Environment Variables,
# you MUST trigger a new deployment (redeploy) for the env variable to take effect.
# Just setting the variable is not enough - it needs to be baked into the build.
NEXT_PUBLIC_API_URL=http://localhost:8000
